# Copy this file to apps/web/.env.local and replace every placeholder.
# Next.js and `npm run db:migrate` read apps/web/.env.local.
# This file is not loaded. Server only: do not add a NEXT_PUBLIC_ prefix.

# Historic Service Performance, from the Rail Data Marketplace (raildata.org.uk).
# Subscribe to that product and copy its base URL and Consumer key.
# Required. The key is sent in the header named below. The marketplace uses x-apikey.
HSP_BASE_URL=https://example.invalid/hsp
HSP_API_KEY_HEADER=x-apikey
HSP_API_KEY=replace-with-consumer-key

# Knowledgebase Stations JSON feed, also from the Rail Data Marketplace.
# Subscribe to that product and copy its base URL and Consumer key. Required.
# The server stores name and CRS only, outside Git, and refreshes them daily.
STATIONS_BASE_URL=https://example.invalid/stations
STATIONS_API_KEY=replace-with-stations-consumer-key

# Optional. HSP requests per second. Default 3.
# Shared by every server process when DATABASE_URL is set.
# HSP_MAX_REQUESTS_PER_SECOND=3

# Optional. How many HSP calls one search or one calculation keeps in flight.
# Defaults keep HSP from answering 503: 2 list calls, 1.5 s apart, 1 detail call.
# Raising them is for a manual load test. HSP then refuses calls, and three 5xx
# in a row open the circuit for 45 s. List slots are shared when DATABASE_URL is set.
# The schema inserts slots 1–12, the highest list-worker count.
# HSP_LIST_WORKERS=2
# HSP_LIST_SLOT_COUNT=2
# HSP_LIST_START_GAP_MS=1500
# HSP_DETAIL_CONCURRENCY=1
# HSP_SERIAL_AFTER_REFUSAL_MS=180000

# Optional. Postgres connections in this process. Default 3.
# DATABASE_POOL_MAX=3

# Optional. HSP calls per London day when DATABASE_URL is set. Default 5000.
# Without a database there is no daily cap. Reaching it stops further HSP calls
# until the next London day; trains already stored still load.
# HSP_DAILY_CALL_LIMIT=5000

# Optional. Postgres for stored runs, stored lists, and the shared rate limit.
# Without it, nothing is stored and the rate limit covers one process only.
# On Neon, use the pooled connection string (the hostname contains -pooler).
# Create the tables with: npm run db:migrate
# DATABASE_URL=postgresql://user:password@localhost:5432/railscore

# Optional. Darwin Push Port import (Rail Data Marketplace, "Darwin Real Time Train
# Information", Pub/Sub tab). Copy bootstrap server, SASL mechanism and security protocol
# exactly as shown there. Runs it stores fill RIDs HSP has not given. Needs DATABASE_URL.
# DARWIN_KAFKA_BOOTSTRAP=pkc-example.europe-west2.gcp.confluent.cloud:9092
# DARWIN_KAFKA_SASL_MECHANISM=PLAIN
# DARWIN_KAFKA_SECURITY_PROTOCOL=SASL_SSL
# DARWIN_KAFKA_TOPIC=prod-1010-Darwin-Train-Information-Push-Port-IIII2_0-XML
# DARWIN_KAFKA_GROUP=replace-with-consumer-group
# DARWIN_KAFKA_USERNAME=replace-with-consumer-username
# DARWIN_KAFKA_PASSWORD=replace-with-consumer-password

# Optional. Hourly Darwin snapshots ("Darwin Real Time Train Information snapshots"),
# read when Kafka dropped messages before an import got to them.
# DARWIN_SNAPSHOT_URL=https://api1.raildata.org.uk/1010-darwin-real-time-train-information-snapshots1_0/download/snapshot
# DARWIN_SNAPSHOT_CONSUMER_KEY=replace-with-snapshot-consumer-key

# Optional. Days of Darwin runs kept. Default 30. A day of the whole network is about 10 MB.
# DARWIN_KEEP_DAYS=30

# Optional. Turns on /api/import/darwin. The scheduler sends it as a Bearer token.
# CRON_SECRET=replace-with-a-long-random-string

# Optional. Leave unset for the live feed.
# mock serves made-up trains so the screens can be tried without the marketplace.
# RAILSCORE_DATA=mock

# Optional. Port for `npm run dev`. Default 3000.
# PORT=3000

# Optional. Set to 1 to log each HSP call. Off by default.
# RAILSCORE_LOG_HSP=1
